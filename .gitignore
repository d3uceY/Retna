# Build output
/retna
/retna.exe
*.exe

# GoReleaser working directory
/dist/

# Binaries unpacked out of a GitHub release into the npm platform packages.
# The release workflow puts them here before publishing; they are not source.
/npm/**/bin/

# Installed dependencies, if anyone runs npm install or npm link in the
# package tree while working on it.
/node_modules/
/npm/**/node_modules/

# The npm README is generated from the root one by npm/scripts/readme.js, so
# that the package page cannot drift from the repo's documentation.
/npm/README.md

# Local credentials and the release version for the by-hand publish path.
# .env.example is the committed shape.
/.env

# Test binaries
*.test
*.out

# Scratch files
/palette.txt

# Reference clones kept out of the repo
/references/
