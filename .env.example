# Credentials and the release version for working on a release from this
# machine. Copy it, then fill in what you need:
#
#   Copy-Item .env.example .env
#
# The release workflow does not read this file. CI gets the same values from
# repository secrets, under the names noted below.

# The release tag this checkout is publishing, with or without the leading v.
# Set it here once and the scripts under npm/scripts stop taking a version
# argument:
#
#   node --env-file=.env npm/scripts/version.js
RETNA_VERSION=v0.2.0

# npm credential, for the by-hand publish path. A granular access token, for
# example:
#
#   NPM_AUTH_TOKEN=npm_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
#
# Every npm token has that shape, whatever kind it is. For npm to pick this one
# up, the shell running npm needs the variable and ~/.npmrc needs one line:
#
#   //registry.npmjs.org/:_authToken=${NPM_AUTH_TOKEN}
#
# Leave it empty to use `npm login` instead, which writes a session token to
# ~/.npmrc for you. Do one or the other: two _authToken lines for the same
# registry fight over which one wins. A session login is the one the first
# publish needs, because `npm stage approve` is proof-of-presence and wants a
# 2FA prompt no stored token can give it. CI's secret is named NPM_AUTH_TOKEN
# too, and there it is a stage-only token with no 2FA bypass.
NPM_AUTH_TOKEN=

# GoReleaser, only when a release is cut from this machine instead of CI.
# `goreleaser release --clean` reads GITHUB_TOKEN to create the release and
# upload the archives, and .goreleaser.yaml reads HOMEBREW_TAP_GITHUB_TOKEN to
# push the cask to d3uceY/homebrew-retna, a second repository. See
# CONTRIBUTING.md, "The Homebrew tap". CI calls that secret PUBLISHER_TOKEN.
GITHUB_TOKEN=
HOMEBREW_TAP_GITHUB_TOKEN=
